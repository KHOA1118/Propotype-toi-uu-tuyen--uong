# Server reads environment variables; .env is documentation, not auto-loaded.
HOST=127.0.0.1
PORT=8011
# Empty = same-origin API (recommended, frontend and backend on one service).
API_BASE_URL=
ALLOWED_ORIGINS=
# Optional source override; default is relative to server.py.
MAP_DATA=data/raw/hcm_map4.osm
# Render sets PORT; render.yaml sets HOST=0.0.0.0.
